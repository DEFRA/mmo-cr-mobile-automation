{
    "name": "record-your-catch-appium",
    "version": "1.0.0",
    "private": true,
    "description": "WebdriverIO + Appium test automation for the Record Your Catch Android app (TypeScript)",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "test:android": "wdio run ./config/wdio.android.conf.ts",
        "test:android:spec": "wdio run ./config/wdio.android.conf.ts --spec",
        "test:android:browserstack": "wdio run ./config/wdio.android.browserstack.conf.ts",
        "test:android:browserstack:spec": "wdio run ./config/wdio.android.browserstack.conf.ts --spec",
        "test:ios": "wdio run ./config/wdio.ios.conf.ts",
        "test:ios:spec": "wdio run ./config/wdio.ios.conf.ts --spec",
        "test:ios:browserstack": "wdio run ./config/wdio.ios.browserstack.conf.ts",
        "test:ios:browserstack:spec": "wdio run ./config/wdio.ios.browserstack.conf.ts --spec",
        "postinstall": "tsx scripts/patch-webdriver.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "generate:report": "allure generate allure-results --clean && allure open"
    },
    "devDependencies": {
        "@types/node": "^26.6.1",
        "@wdio/allure-reporter": "^9.30.1",
        "@wdio/appium-service": "^9.31.9",
        "@wdio/browserstack-service": "^9.36.1",
        "@wdio/cli": "^9.31.9",
        "@wdio/globals": "^9.29.1",
        "@wdio/local-runner": "^9.31.9",
        "@wdio/mocha-framework": "^9.31.9",
        "@wdio/spec-reporter": "^9.30.1",
        "allure-commandline": "^2.46.1",
        "prettier": "^3.9.7",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "@grpc/grpc-js": "1.14.4",
        "serialize-javascript": "^7.0.7",
        "uuid": "11.1.1",
        "@puppeteer/browsers": "^3.2.0",
        "@xmldom/xmldom": "0.9.12",
        "js-yaml": "4.3.2"
    }
}
